# Copy to docs/demo/ids.env and fill every value from the measured run it names. Nothing here is a default:
# an unset value stops the recording and the demo preflight.
#
# candidates for the replay matrix (one the replay rejects, one it clears), as `ratchet show lineage` prints them
REJECTED_CAND=
CLEARED_CAND=
# the failing trace of the double refund: run_id/case_id
BAD_TRACE=
# decisions: one rejected on replay, one admitted, one rejected for authority growth
REJECTED_DECISION=
ADMITTED_DECISION=
AUTHORITY_DECISION=
# file the background evolve run writes (demo.py evolve-bg creates it)
EVOLVE_LOG=docs/demo/out/evolve.log
# measured-results text files written by the results lane
RESULTS_FILE=docs/results/summary.txt
LEVEL2_FILE=docs/results/level2.txt
# the case whose interrupted run is resumed, and the command that resumes it
RESUME_CMD=
# Raindrop cohort page, opened in a browser tab before the demo
RAINDROP_URL=

# numbers quoted in video captions and posts: each copied from the stored report it names, never typed from memory
REPLAY_TRACES=
REPLAY_SECONDS=
PARENT_PASS=
CAND_PASS=
HELDOUT_N=
AGENTDOJO_N=
TAU_N=
LEVEL2_RESULT=
